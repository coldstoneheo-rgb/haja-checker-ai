# Vercel/로컬 환경변수 예시
# 실제 키는 Vercel 프로젝트 Settings > Environment Variables 에 등록한다.
# 로컬에서는 이 파일을 .env.local로 복사 후 채워 사용.

# ===== Claude Vision API (D-7에서 연동) =====
# Anthropic 콘솔 https://console.anthropic.com/settings/keys 에서 발급
# 서버 라우트(`app/api/analyze`)에서만 사용. 클라이언트로 노출 금지.
ANTHROPIC_API_KEY=

# ===== 모델 선택 (선택) =====
# 비용/지연 vs 정확도 트레이드오프. 기본값은 코드에서 sonnet으로 처리.
# - claude-sonnet-4-6 (권장): 비용·속도 균형
# - claude-opus-4-7: 더 정확하나 느리고 비쌈
# - claude-haiku-4-5-20251001: 빠르고 저렴, 정확도 낮음
ANTHROPIC_VISION_MODEL=claude-sonnet-4-6
