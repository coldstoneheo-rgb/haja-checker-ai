# Vercel/로컬 환경변수 예시
# 실제 키는 Vercel 프로젝트 Settings > Environment Variables 에 등록한다.
# 로컬에서는 이 파일을 .env.local로 복사 후 채워 사용.

# ===== Gemini Vision API (D-7에서 연동) =====
# Google AI Studio https://aistudio.google.com/apikey 에서 발급.
# ⚠️ 무료 티어는 입력 데이터를 모델 학습에 사용할 수 있어, 사용자 거주 공간
#    사진을 다루는 본 앱 특성상 *유료(빌링 활성화) 사용*을 권장한다.
# 서버 라우트(`app/api/analyze`)에서만 사용. 클라이언트로 노출 금지.
GEMINI_API_KEY=

# ===== 모델 선택 (선택) =====
# 비용/지연 vs 정확도 트레이드오프. 점검 1회(사진 75장) 추정치 기준:
# - gemini-3-flash-preview  (권장, 5/11 점검까지 명시 버전 고정 — 안정)
#     · Input $0.30 / Output $2.50 / M tokens — 약 $0.13/inspection
# - gemini-flash-latest      (alias, 자동 업데이트되므로 v2부터 사용 권장)
# - gemini-flash-lite-latest (= 2.5-flash-lite, 6배 저렴 ~$0.02/inspection
#     이지만 한국어·비전 정확도 낮음. 비용 극단 절감 시에만)
# - gemini-3.1-flash-lite-preview (input cost가 $0.50으로 비싸 우리 워크로드에
#     불리. agentic/data-processing 용도에 최적화)
GEMINI_VISION_MODEL=gemini-3-flash-preview

# ===== AI 분석기 선택 (선택) =====
# - gemini  (기본, 위 키 필요)
# - mock    (네트워크 없이 deterministic 응답, 개발/오프라인 데모용)
AI_ANALYZER=gemini
