# Vercel/로컬 환경변수 예시
# 실제 키는 Vercel 프로젝트 Settings > Environment Variables 에 등록한다.
# 로컬에서는 이 파일을 .env.local로 복사 후 채워 사용.

# ===== Gemini Vision API (D-7에서 연동) =====
# Google AI Studio https://aistudio.google.com/apikey 에서 발급.
# ⚠️ 무료 티어는 입력 데이터를 모델 학습에 사용할 수 있어, 사용자 거주 공간
#    사진을 다루는 본 앱 특성상 *유료(빌링 활성화) 사용*을 권장한다.
# 서버 라우트(`app/api/analyze`)에서만 사용. 클라이언트로 노출 금지.
GEMINI_API_KEY=

# ===== 모델 선택 (선택) =====
# 비용/지연 vs 정확도 트레이드오프. 점검 1회(사진 75장, 항목별 개별 호출) 추정:
# - gemini-3.1-flash-lite-preview (권장 default)
#     · Input $0.25 / Output $1.50 / M tokens — 약 $0.17/inspection
#     · Gemini 3.1 세대 lite. agentic/translation 최적화이지만 responseSchema +
#       사용자 검토 흐름이라 품질 손실 영향 적음.
# - gemini-3-flash-preview (= gemini-flash-latest)
#     · Input $0.30 / Output $2.50 / M tokens — 약 $0.24/inspection
#     · 풀 Flash 모델. 보고서 문구 품질이 미세하게 더 좋음. 비용 30% 더 비쌈.
#     · 5/11 점검 직전 테스트에서 lite 의 출력이 어색하면 이 모델로 환원.
# - gemini-flash-lite-latest (= gemini-2.5-flash-lite-preview-09-2025)
#     · Input $0.10 / Output $0.40 / M tokens — 약 $0.06/inspection
#     · 6배 저렴하지만 2.5세대 lite — 한국어/비전 정확도 위험. 비추.
GEMINI_VISION_MODEL=gemini-3.1-flash-lite-preview

# ===== AI 분석기 선택 (선택) =====
# - gemini  (기본, 위 키 필요)
# - mock    (네트워크 없이 deterministic 응답, 개발/오프라인 데모용)
AI_ANALYZER=gemini
