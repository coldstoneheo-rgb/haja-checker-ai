{
  "name": "haja-checker-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p toss",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:toss": "vite --config vite.config.mts --host",
    "build:toss": "vite build --config vite.config.mts && ait build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.4.0",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.7",
    "vitest": "^4.1.5"
  }
}
